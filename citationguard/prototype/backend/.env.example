# Copy values to your local process environment or an ignored .env file. Never commit real keys.
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
EMBEDDING_PROVIDER=siliconflow
RERANK_PROVIDER=siliconflow
CLAIM_EXTRACTION_PROVIDER=siliconflow
LLM_PROVIDER=siliconflow
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
SILICONFLOW_CLAIM_MODEL=Qwen/Qwen3.5-35B-A3B
SILICONFLOW_AUDIT_MODEL=Qwen/Qwen3.5-122B-A10B
SILICONFLOW_REVIEWER_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_ENABLE_RISK_REVIEW=true
OCR_PROVIDER=siliconflow
SILICONFLOW_OCR_MODEL=PaddlePaddle/PaddleOCR-VL-1.5
OCR_MIN_TEXT_CHARACTERS=80
OCR_MAX_PAGES=10
RETRIEVAL_CANDIDATE_K=20
ACCESS_KEY_REQUIRED=false
LOG_LEVEL=INFO
DATABASE_URL=
OBJECT_STORAGE_PROVIDER=local
UPLOAD_DIR=data/uploads
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SERVER_SIDE_ENCRYPTION=AES256
